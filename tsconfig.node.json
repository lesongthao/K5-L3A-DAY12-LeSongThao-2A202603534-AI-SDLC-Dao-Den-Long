  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022"], "module": "NodeNext",
    "moduleResolution": "NodeNext", "strict": true, "skipLibCheck": true,
    "rootDir": "src", "outDir": "dist/node", "types": ["node"],
    "esModuleInterop": true
  },
  "include": ["src/core/**/*.ts", "src/headless/**/*.ts"]
}
